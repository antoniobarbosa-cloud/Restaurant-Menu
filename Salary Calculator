<!DOCTYPE html>
<html>
    <head>
        <style>
            body {   
                color: Black;
                background-color: AliceBlue;
            }
            
            button {
                background-color: black;
                border: none;
                border-radius: 10px;
                padding: 15px 17px;
                box-shadow: 4px 4px 4px gray;
                color: White;
            }
            
            button:hover {
                background-color: gray;  
                cursor: pointer;
                scale: 1.3;
                transition: 0.5s;   
            }

            h1 {
                text-align: start;
            }

            div {
                text-align: start;
            }

            #display1 {
                color: red;
                font-size: 18px
            }

            #display2 {
                color: red;
                font-size: 18px
            }
        </style> 
    </head>

    <body>
        <h1> Job Payment Calculator</h1>
        
        <div>
            <h2> HOW MUCH YOU RECEIVE DURING A DAY</h2>
        </div>

        <div>
            <h3> How much do you receive per Hour</h3>
            <input id="perhour">
        </div>
        
        <div>
            <h3> How many Hours do you Work</h3>
            <input id="hourwork">
        </div>
        
        <div>
            <p>
            </p>
            <button onclick="Result()">Calculate</button>
        </div>

        <div>
            <h2 id="display1"></h2>
        </div>

        <div>
            <h2> HOW MUCH YOU RECEIVE + EXTRA HOURS</h2>
        </div>

        <div>
            <h3> How many Extra Hours do you Work</h3>
            <input id="hourwork2">
        </div>

        <div>
            <p>
            </p>
            <button onclick="Result2()">Calculate</button>
        </div>

        <div>
            <h2 id="display2"></h2>
        </div>

        <script>

        function Result() {

    var moneyperhour = Number(document.getElementById("perhour").value);
    
    var hoursofwork = Number(document.getElementById("hourwork").value);

    var totalperday = hoursofwork * moneyperhour;
                
        document.getElementById("display1").innerHTML = "After a whole day of work, you'll receive " + totalperday + " Reais.";
            }
        
        function Result2() {

    var moneyperhour = Number(document.getElementById("perhour").value);

    var hoursofwork = Number(document.getElementById("hourwork").value);

    var hoursofwork2 = Number(document.getElementById("hourwork2").value);

    var extrahourmoney = moneyperhour * 1.8;

    var extramoneyperhour = extrahourmoney * hoursofwork2;

    var totalperday = moneyperhour * hoursofwork;

    var extramoneytotal = extramoneyperhour + totalperday;

        document.getElementById("display2").innerHTML = "After a whole day of work + extra hours, you'll receive " + extramoneytotal + " Reais.";
            }

        </script>
        
    </body>
</html>
